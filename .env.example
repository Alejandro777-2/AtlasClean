# Copia este archivo como .env (no se sube a git) y completa tu clave.
# Sin clave, el Asistente de Visita funciona en modo demostración (reglas locales, sin IA).
ANTHROPIC_API_KEY=

# Opcional: forzar otro modelo. Por defecto se usa el del archivo del agente.
ATLAS_MODELO_IA=

# Opcional: dónde se guarda el Excel de solicitudes de clientes (relativo a la carpeta del proyecto).
# Por defecto: registros/solicitudes_clientes.xlsx
ATLAS_EXCEL_SOLICITUDES=
